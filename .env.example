NODE_ENV=development
PORT=3000

# Віддалений PostgreSQL. Спецсимволи в паролі потрібно URL-кодувати.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Ключ для сервісу-джерела платежів (заголовок X-API-Key), мінімум 32 символи.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXTERNAL_API_KEY=""

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=""
# Чат адміністраторів (група: від'ємне число, напр. -1002286861249)
TELEGRAM_ADMIN_CHAT_ID=""
