NODE_ENV=development
PORT=3000

# Віддалений PostgreSQL. Спецсимволи в паролі потрібно URL-кодувати.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?schema=public"

# Ключ для сервісу-джерела платежів (заголовок X-API-Key), мінімум 32 символи.
# Згенерувати: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
EXTERNAL_API_KEY=""

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=""
# Чат адміністраторів (група: від'ємне число, напр. -1002286861249). Сюди ж бот надсилає файли,
# прикріплені до замовлень (скріншоти, PDF) — окремого сховища для них немає.
TELEGRAM_ADMIN_CHAT_ID=""

# Секрет підпису сесій вебкабінету, мінімум 32 символи (згенерувати так само, як EXTERNAL_API_KEY)
WEB_JWT_SECRET=""
# Telegram ID перших адміністраторів кабінету через кому. При вході через Telegram такий користувач стає
# активним ADMIN, якщо ще не зареєстрований, чекає схвалення або в кабінеті немає жодного активного адміна.
# Рішень, ухвалених у кабінеті (роль, закритий доступ), список не перебиває.
ADMIN_TELEGRAM_IDS=""
